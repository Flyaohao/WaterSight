# 生产环境配置
NODE_ENV = 'production'

# SpringBoot 后端 API 地址
VUE_APP_BASE_API = 'http://localhost:9090'

# Python FastAPI 服务地址（目标识别 YOLOv5）
VUE_APP_PYTHON_URL = 'http://localhost:8000'

# 图像增强服务
VUE_APP_ENHANCE_URL = 'http://localhost:8002'

# 模拟数据集生成服务
VUE_APP_DATASET_URL = 'http://localhost:8001'

# 演示视频根地址（本地 assets/videos 缺失时回退使用，需以 / 结尾）
VUE_APP_DEMO_VIDEO_BASE = ''
